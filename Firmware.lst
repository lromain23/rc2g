.................... void dtmf_write(int data,int1 rs) { // {{{
....................   int1 dbit;
.................... // Write Data Bits {{{
....................   set_tris_d(0x00);
*
05D0:  MOVLW  00
05D1:  MOVLB  01
05D2:  MOVWF  0F
....................   dbit=((data&0x0F)&0x01)!=0;
05D3:  MOVLB  02
05D4:  BCF    4E.0
05D5:  CALL   60C
05D6:  ANDLW  01
05D7:  BTFSS  03.2
05D8:  BSF    4E.0
*
060C:  MOVF   4C,W
060D:  ANDLW  0F
060E:  RETURN
....................   output_bit(DTMF_D0,dbit);
*
05D9:  BTFSC  4E.0
05DA:  GOTO   5DD
05DB:  BCF    0F.0
05DC:  GOTO   5DE
05DD:  BSF    0F.0
....................   dbit=((data&0x0F)&0x02)!=0;
05DE:  BCF    4E.0
05DF:  CALL   60C
05E0:  ANDLW  02
05E1:  BTFSS  03.2
05E2:  BSF    4E.0
....................   output_bit(DTMF_D1,dbit);
05E3:  BTFSC  4E.0
05E4:  GOTO   5E7
05E5:  BCF    0F.1
05E6:  GOTO   5E8
05E7:  BSF    0F.1
....................   dbit=((data&0x0F)&0x04)!=0;
05E8:  BCF    4E.0
05E9:  CALL   60C
05EA:  ANDLW  04
05EB:  BTFSS  03.2
05EC:  BSF    4E.0
....................   output_bit(DTMF_D2,dbit);
05ED:  BTFSC  4E.0
05EE:  GOTO   5F1
05EF:  BCF    0F.2
05F0:  GOTO   5F2
05F1:  BSF    0F.2
....................   dbit=((data&0x0F)&0x08)!=0;
05F2:  BCF    4E.0
05F3:  CALL   60C
05F4:  ANDLW  08
05F5:  BTFSS  03.2
05F6:  BSF    4E.0
....................   output_bit(DTMF_D3,dbit);
05F7:  BTFSC  4E.0
05F8:  GOTO   5FB
05F9:  BCF    0F.3
05FA:  GOTO   5FC
05FB:  BSF    0F.3
.................... // }}}
....................   output_bit(DTMF_RS,rs);
05FC:  MOVF   4D,F
05FD:  BTFSS  03.2
05FE:  GOTO   601
05FF:  BCF    0F.6
0600:  GOTO   602
0601:  BSF    0F.6
....................   delay_cycles(2);
0602:  GOTO   603
....................   output_bit(DTMF_WEB,0);
0603:  BCF    0F.5
....................   delay_cycles(2);
0604:  GOTO   605
....................   output_bit(DTMF_WEB,1);  
0605:  BSF    0F.5
....................   //output_bit(DTMF_RS,DATA_REG);
....................   delay_cycles(2);
0606:  GOTO   607
....................   set_tris_d(0x0F);
0607:  MOVLW  0F
0608:  MOVLB  01
0609:  MOVWF  0F
060A:  MOVLB  00
060B:  RETURN
.................... } // }}}
.................... int dtmf_read(int rs) { // {{{
....................   int value;
....................   set_tris_d(0x0F);
*
060F:  MOVLW  0F
0610:  MOVLB  01
0611:  MOVWF  0F
....................   output_bit(DTMF_RS,rs);
0612:  MOVLB  02
0613:  MOVF   43,F
0614:  BTFSS  03.2
0615:  GOTO   618
0616:  BCF    0F.6
0617:  GOTO   619
0618:  BSF    0F.6
....................   delay_cycles(1);
0619:  NOP
....................   output_bit(DTMF_REB,0);
061A:  BCF    0F.4
....................   delay_cycles(1);
061B:  NOP
....................   value=input_d();
061C:  MOVLB  00
061D:  MOVF   0F,W
061E:  MOVLB  02
061F:  MOVWF  44
....................   value&=0x0F;
0620:  MOVLW  0F
0621:  ANDWF  44,F
....................   output_bit(DTMF_REB,1);
0622:  BSF    0F.4
....................   //output_bit(DTMF_RS,DATA_REG);  
....................   delay_cycles(1);
0623:  NOP
....................   return(value);
0624:  MOVF   44,W
0625:  MOVWF  78
0626:  MOVLB  00
0627:  RETURN
.................... } // }}}
