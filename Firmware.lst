.................... void update_checksum (int *cksum,int value) { // {{{
....................   const int seed = 0x09;
....................   int tmp;
.................... 
....................   tmp=*cksum;
*
05CD:  MOVLB  02
05CE:  CALL   5DF
05CF:  MOVF   00,W
05D0:  MOVWF  4C
*
05DF:  MOVF   49,W
05E0:  MOVWF  04
05E1:  MOVF   4A,W
05E2:  MOVWF  05
05E3:  RETURN
....................   if ( tmp > 127 ) {
*
05D1:  MOVF   4C,W
05D2:  SUBLW  7F
05D3:  BTFSS  03.0
....................     tmp++;
05D4:  INCF   4C,F
....................   }
....................   tmp = ((tmp << 1)^seed)+value;
05D5:  BCF    03.0
05D6:  RLF    4C,W
05D7:  XORLW  09
05D8:  ADDWF  4B,W
05D9:  MOVWF  4C
....................   *cksum=tmp;
05DA:  CALL   5DF
05DB:  MOVF   4C,W
05DC:  MOVWF  00
05DD:  MOVLB  00
05DE:  RETURN
.................... } // }}}
