.................... #define AUX_OUT_FOLLOW_COR_INVERT1 0x10
.................... #define AUX_OUT_FOLLOW_COR_INVERT2 0x20
.................... #define AUX_OUT_FOLLOW_COR_INVERT3 0x40
.................... #define AUX_OUT_FOLLOW_COR_INVERT4 0x80
.................... // Follow AUX_IN args:
