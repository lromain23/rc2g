1EDB:  BTFSS  03.2
1EDC:  GOTO   6E2
....................       execute_command();
1EDD:  MOVLP  10
1EDE:  MOVLB  00
1EDF:  CALL   0F6
1EE0:  MOVLP  18
1EE1:  MOVLB  01
....................     }
....................   }
....................   // Allow 'b', 'c' and 'd' to turn 'down' and 'up' potentiometer {{{
....................   // 'b' --> Next pot (DTMF 14)
....................   // 'c' --> pot down (DTMF 15)
....................   // 'd' --> pot up   (DTMF 13)
....................   command=DTMF_ARRAY[0].Key;
1EE2:  MOVF   3A,W
1EE3:  ANDLW  0F
1EE4:  MOVWF  70
....................   if ( AdminMode && ValidKeyRange(0,0) ) {
