.................... void lcd_write(char rs, char data) { // {{{
....................   char lcd_word_a,lcd_word_b;
....................   lcd_word_a = LCD_WRITE | BT | (data&0xF0);
....................   lcd_word_b = LCD_WRITE | BT | ((data<<4)&0xF0);
....................   if ( rs ) {
....................     lcd_word_a |= RS;
....................     lcd_word_b |= RS;
....................   } 
....................   lcd_strobe(lcd_word_a);
....................   lcd_strobe(lcd_word_b);
.................... } // }}}
