.................... void update_checksum (int *cksum,int value) { // {{{
....................   const int seed = 0x09;
....................   int tmp;
.................... 
....................   tmp=*cksum;
*
04C5:  MOVLB  02
04C6:  CALL   4D7
04C7:  MOVF   00,W
04C8:  MOVWF  44
*
04D7:  MOVF   41,W
04D8:  MOVWF  04
04D9:  MOVF   42,W
04DA:  MOVWF  05
04DB:  RETURN
....................   if ( tmp > 127 ) {
*
04C9:  MOVF   44,W
04CA:  SUBLW  7F
04CB:  BTFSS  03.0
....................     tmp++;
04CC:  INCF   44,F
....................   }
....................   tmp = ((tmp << 1)^seed)+value;
04CD:  BCF    03.0
04CE:  RLF    44,W
04CF:  XORLW  09
04D0:  ADDWF  43,W
04D1:  MOVWF  44
....................   *cksum=tmp;
04D2:  CALL   4D7
04D3:  MOVF   44,W
04D4:  MOVWF  00
04D5:  MOVLB  00
04D6:  RETURN
.................... } // }}}
