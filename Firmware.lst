.................... void update_checksum (int *cksum,int value) { // {{{
....................   const int seed = 0x09;
....................   int tmp;
.................... 
....................   tmp=*cksum;
*
04B3:  MOVLB  02
04B4:  CALL   4C5
04B5:  MOVF   00,W
04B6:  MOVWF  44
*
04C5:  MOVF   41,W
04C6:  MOVWF  04
04C7:  MOVF   42,W
04C8:  MOVWF  05
04C9:  RETURN
....................   if ( tmp > 127 ) {
*
04B7:  MOVF   44,W
04B8:  SUBLW  7F
04B9:  BTFSS  03.0
....................     tmp++;
04BA:  INCF   44,F
....................   }
....................   tmp = ((tmp << 1)^seed)+value;
04BB:  BCF    03.0
04BC:  RLF    44,W
04BD:  XORLW  09
04BE:  ADDWF  43,W
04BF:  MOVWF  44
....................   *cksum=tmp;
04C0:  CALL   4C5
04C1:  MOVF   44,W
04C2:  MOVWF  00
04C3:  MOVLB  00
04C4:  RETURN
.................... } // }}}
