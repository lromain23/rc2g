.................... #INT_RDA
.................... void rs232_int (void) { // {{{
.................... // RS232 serial buffer interrupt handler.
....................   char c;
....................   if ( kbhit() ) {
02C8:  BTFSS  11.5
02C9:  GOTO   31F
....................     c = getc();
02CA:  CLRWDT
02CB:  BTFSS  11.5
02CC:  GOTO   2CA
02CD:  MOVLB  03
02CE:  MOVF   19,W
02CF:  MOVWF  50
....................     if ( c == '\b' ) {
02D0:  MOVF   50,W
02D1:  SUBLW  08
02D2:  BTFSS  03.2
02D3:  GOTO   2FA
....................       if ( sBufferIndex > 0 ) {
02D4:  MOVF   7E,F
02D5:  BTFSC  03.2
02D6:  GOTO   2F5
....................         sBufferIndex--;
02D7:  DECF   7E,F
....................         sBuffer[sBufferIndex]='\0';
02D8:  MOVLW  52
02D9:  ADDWF  7E,W
02DA:  MOVWF  04
02DB:  MOVLW  20
02DC:  MOVWF  05
02DD:  BTFSC  03.0
02DE:  INCF   05,F
02DF:  CLRF   00
....................         putc('\b');
02E0:  MOVLW  08
02E1:  MOVLB  00
02E2:  CALL   2C1
....................   // Erase End of Line <ESC>[K
....................   putc(ESC);
02E3:  MOVLW  1B
02E4:  CALL   2C1
....................   printf("[K");
02E5:  MOVLW  5B
02E6:  CLRWDT
02E7:  BTFSS  11.4
02E8:  GOTO   2E6
02E9:  MOVLB  03
02EA:  MOVWF  1A
02EB:  MOVLW  4B
02EC:  CLRWDT
02ED:  MOVLB  00
02EE:  BTFSC  11.4
02EF:  GOTO   2F2
02F0:  MOVLB  03
02F1:  GOTO   2EC
02F2:  MOVLB  03
02F3:  MOVWF  1A
....................       } else {
02F4:  GOTO   2F9
....................         putc('\a'); // Send alert. Cannot backspace further
02F5:  MOVLW  07
02F6:  MOVLB  00
02F7:  CALL   2C1
02F8:  MOVLB  03
....................       }
....................     } else if (sBufferIndex < sizeof(sBuffer)) {
02F9:  GOTO   320
02FA:  MOVF   7E,W
02FB:  SUBLW  0F
02FC:  BTFSS  03.0
02FD:  GOTO   31C
....................       putc(c); // echo the character
02FE:  MOVF   50,W
02FF:  MOVLB  00
0300:  CALL   2C1
....................       sBuffer[sBufferIndex++] = c;
0301:  MOVF   7E,W
0302:  INCF   7E,F
0303:  ADDLW  52
0304:  MOVWF  04
0305:  MOVLW  20
0306:  MOVWF  05
0307:  BTFSC  03.0
0308:  INCF   05,F
0309:  MOVLB  03
030A:  MOVF   50,W
030B:  MOVWF  00
....................       if ( c == '\r' || c=='+' || c=='-') {
030C:  MOVF   50,W
030D:  SUBLW  0D
030E:  BTFSC  03.2
