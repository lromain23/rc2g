0529:  BTFSS  03.0
....................     tmp++;
052A:  INCF   44,F
....................   }
....................   tmp = ((tmp << 1)^seed)+value;
052B:  BCF    03.0
052C:  RLF    44,W
052D:  XORLW  09
052E:  ADDWF  43,W
052F:  MOVWF  44
....................   *cksum=tmp;
0530:  CALL   535
0531:  MOVF   44,W
0532:  MOVWF  00
0533:  MOVLB  00
0534:  RETURN
.................... } // }}}
